# Copier en infra/proxy/.env sur le serveur (non versionné).
ACME_EMAIL=votre-email@example.com
# Exemple avec DuckDNS (sous-domaine gratuit) : les sous-sous-domaines pointent vers la même IP.
PROD_DOMAIN=app.mon-projet.duckdns.org
PREPROD_DOMAIN=preprod.mon-projet.duckdns.org
GRAFANA_DOMAIN=monitoring.mon-projet.duckdns.org
PREPROD_BASIC_AUTH_USER=preprod
# Hash bcrypt, généré avec : docker run --rm caddy:2-alpine caddy hash-password --plaintext 'motdepasse'
# Mettre la valeur entre apostrophes (le hash contient des $).
PREPROD_BASIC_AUTH_HASH='$2a$14$...'
