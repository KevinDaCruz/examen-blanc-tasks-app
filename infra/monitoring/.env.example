# Copier en infra/monitoring/.env sur le serveur (non versionné).
GRAFANA_DOMAIN=monitoring.mon-projet.duckdns.org
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Notifications d'alertes (push) via ntfy : choisir un nom de topic impossible à deviner,
# ex: tasks-alertes-$(openssl rand -hex 8), puis s'y abonner dans l'application ntfy.
NTFY_URL=https://ntfy.sh/tasks-alertes-xxxxxxxxxxxxxxxx
