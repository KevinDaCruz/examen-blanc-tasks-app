# Copier en infra/monitoring/.env sur le serveur (non versionné).
GRAFANA_DOMAIN=monitoring.mon-projet.duckdns.org
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Envoi des alertes par e-mail (SMTP fourni pour l'examen, ou Gmail avec mot de passe d'application)
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alertes@example.com
SMTP_USER=alertes@example.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=vous@example.com
