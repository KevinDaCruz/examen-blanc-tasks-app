{
  "name": "backend",
  "version": "2.0.0",
  "description": "API REST de l'application de gestion de tâches (Express 5 / MongoDB)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development DEBUG=app:* node --watch server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "jsdoc -c jsdoc.json",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.1",
    "morgan": "^1.12.1",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
