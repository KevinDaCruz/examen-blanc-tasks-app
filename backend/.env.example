# Copier ce fichier en .env puis remplir les valeurs.
# En pré-production / production, ces variables sont injectées par l'hébergeur
# ou par les secrets GitHub Actions : elles ne sont jamais versionnées.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/exam_practice_db
# Obligatoire, 32 caractères minimum. Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000
# error | warn | info | http | debug
LOG_LEVEL=info
# Dossier des fichiers de logs (optionnel ; vide = console uniquement)
LOG_DIR=
# Cookie Secure (HTTPS) - vrai par défaut si NODE_ENV=production
# COOKIE_SECURE=true
