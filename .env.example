# Modèle de configuration d'un environnement Docker (pré-production ou production).
# Copier en .env.preprod / .env.prod sur le serveur. NE JAMAIS VERSIONNER ces fichiers.
# Générer chaque secret avec : openssl rand -hex 32

# Nom de l'environnement : preprod | prod (sert aux noms de réseau / alias de supervision)
ENV_NAME=preprod
# URL publique HTTPS du site (sert aussi d'origine CORS autorisée)
PUBLIC_URL=https://preprod.example.com

# Images Docker (registre + tag poussés par la CI)
REGISTRY=ghcr.io/votre-compte
IMAGE_TAG=latest

# Port local du frontend (le reverse-proxy HTTPS pointe dessus). preprod=8081, prod=8080 par ex.
BIND_ADDRESS=127.0.0.1
APP_PORT=8081

# MongoDB
MONGO_DB=exam_practice_db
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=tasks_app
MONGO_APP_PASSWORD=

# API
JWT_SECRET=
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
COOKIE_SECURE=true
# Proxys devant l'API : Caddy (TLS) + nginx (frontend) = 2
TRUST_PROXY=2
